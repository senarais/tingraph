# Local Compose defaults. Production must use its public HTTPS origin and domain.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
SESSION_COOKIE_NAME=tingraph_session

GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=
SMTP_TLS_MODE=starttls

MIDTRANS_MODE=sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
FX_BASE_URL=https://api.frankfurter.dev
# Gateway fee assumptions: basis points include applicable fee tax. Match your merchant agreement.
GOPAY_FEE_BPS=222
QRIS_FEE_BPS=78
PAYPAL_FEE_BPS=499
PAYPAL_FIXED_CENTS=49
# Product tax for jurisdiction served (0 until you configure applicable tax policy).
PRODUCT_TAX_BPS=0

BACKUP_INTERVAL_SECONDS=86400
